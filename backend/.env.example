# ── LLM (one key is enough; Groq is the low-latency default) ──────────────────
# Preferred: Groq + Llama 3.3 70B. Get a free key at https://console.groq.com
GROQ_API_KEY=

# Alternative: OpenAI. The fast model is used for planning, extraction and diffs.
OPENAI_API_KEY=

# Any OpenAI-compatible endpoint (overrides the two keys above when set).
# Example: LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_FAST_MODEL=

# ── Search (entirely optional; direct DuckDuckGo fallback runs with zero keys) ─
TAVILY_API_KEY=
SERPER_API_KEY=

# ── Runtime ───────────────────────────────────────────────────────────────────
CHRONOS_DB_PATH=chronos.db
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
WATCHER_INTERVAL_SECONDS=45
SEARCH_TIMEOUT_MS=1800
